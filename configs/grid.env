BOT=grid
EXCHANGE=coinbase
QUOTE=USDC
DRY_RUN=false
POST_ONLY=true
CANCEL_ALL_ORDERS_ON_STARTUP=true
PORTFOLIO_FRACTION=0
MM_SELECT=vol
VOL_ENTER_PCT=2
ENTER_RET_MIN=0.003
MM_MAX_PAIRS=4
MM_LEVELS=1
MIN_ORDER_USD=5
GRID_BPS=60
GRID_CLIP_USD=8
GRID_HALF_BPS=55
MIN_EDGE_BPS=20
MAKER_FEE_BPS=35
UPDATE_INTERVAL_MS=2000
USE_USER_WEBSOCKET=true
# Grid wallet key. A Coinbase key is scoped to one portfolio, so the ladder key sees the ladder wallet.
# Put these in .env (not this file):
# GRID_COINBASE_API_KEY=
# GRID_COINBASE_API_SECRET=
# GRID_COINBASE_API_SECRET_FILE=./grid.pem
