# Kraken directional book. Up/flat 15m bar: spot long, same shape as Coinbase.
# Down bar: margin short. A name flattens before it flips. Dry until SHORT_LIVE=1.
EXCHANGE=kraken
QUOTE=USD
BOT=margin
SHORT_BOOK=1
DRY_RUN=1
MARGIN_LEVERAGE=2
MM_ENABLED=1
MM_MAX_PAIRS=4
VOL_ENTER_PCT=2
SHORT_OPEN_RET=0
MIN_EDGE_BPS=20
MAKER_FEE_BPS=16
CLIP_MAX_USD=1.5
INV_NAME_MAX_FRAC=0.25
MIN_ORDER_USD=1
POST_ONLY=1
ALLOW_MARKET_EXIT=0
PORTFOLIO_FRACTION=0
BANK_START_PCT=0
USE_USER_WEBSOCKET=0
STATUS_URL=http://127.0.0.1:8787
