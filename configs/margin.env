# Kraken directional book. Up/flat 15m bar: max margin long. Down bar: max margin short.
# Live: DRY_RUN=0 and SHORT_LIVE=1. Spot coins, including an XLM deposit, are sold for USD.
EXCHANGE=kraken
QUOTE=USD
BOT=margin
SHORT_BOOK=1
DRY_RUN=0
SHORT_LIVE=1
MARGIN_LEVERAGE=2
# US accounts cannot open the international pair. Orders go to PAIR:BTNL.
# max uses each pair's highest US leverage so the deposit covers more names.
MARGIN_LONG=max
MARGIN_SHORT=1
MM_ENABLED=1
MM_MAX_PAIRS=25
VOL_ENTER_PCT=0.4
SHORT_OPEN_RET=0
MIN_EDGE_BPS=20
MAKER_FEE_BPS=40
CLIP_MAX_USD=1.5
INV_NAME_MAX_FRAC=0.50
MIN_ORDER_USD=1
# Leave a resting order until the mid is 200 bps away or the signal flips.
# Repricing on a 30 bps twitch was cancelling bids the market then traded.
HOLD_BPS=200
POST_ONLY=1
ALLOW_MARKET_EXIT=0
PORTFOLIO_FRACTION=0
BANK_START_PCT=0
USE_USER_WEBSOCKET=0
STATUS_URL=http://127.0.0.1:8787
