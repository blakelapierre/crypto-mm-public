# Kraken Pro short book. Same ladder idea, inventory is a short.
# An ask opens the short. A bid only covers it, and is never larger than the short.
# New shorts are placed only while that pair's 15-minute bar is down.
# Not started by the web UI. Stays dry until DRY_RUN=0 and SHORT_LIVE=1.
EXCHANGE=kraken
QUOTE=USD
BOT=margin
SHORT_BOOK=1
DRY_RUN=1
MARGIN_LEVERAGE=2
MM_ENABLED=1
MM_MAX_PAIRS=4
VOL_ENTER_PCT=2
SHORT_OPEN_RET=0
MIN_EDGE_BPS=20
MAKER_FEE_BPS=16
CLIP_MAX_USD=1.5
INV_NAME_MAX_FRAC=0.25
MIN_ORDER_USD=1
POST_ONLY=1
ALLOW_MARKET_EXIT=0
PORTFOLIO_FRACTION=0
BANK_START_PCT=0
USE_USER_WEBSOCKET=0
STATUS_URL=http://127.0.0.1:8787
