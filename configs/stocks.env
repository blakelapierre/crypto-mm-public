# Coinbase equities ladder. One post-only bid and one post-only ask.
# The key is STOCKS_COINBASE_API_KEY / STOCKS_COINBASE_API_SECRET in data/keys.env.
# This bot will not use the crypto COINBASE_API_KEY.
BOT=stocks
EXCHANGE=coinbase
QUOTE=USD
DRY_RUN=true
POST_ONLY=true
CANCEL_ALL_ORDERS_ON_STARTUP=false
MM_ENABLED=true
MM_MAX_PAIRS=4
MM_LEVELS=1
JOIN_TOUCH=true
MIN_HALF_SPREAD_BPS=10
REQUOTE_MOVE_BPS=15
# One rung is at most this many dollars, and a single share above this is skipped.
CLIP_MAX_USD=100
MAX_SHARE_USD=100
# Optional ticker allow-list. Empty scans the venue. Do not hardcode names here.
SYMBOLS=
STOCK_SUBTYPES=COMMON_STOCK,ADR,ETF
STOCK_PROBE=80
LOOP_MS=5000
PRODUCTS_REFRESH_MS=1800000
